{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "bharatcode": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "BharatCode",
      "options": {
        "baseURL": "https://bharatcode.ai/api/model/v1",
        "apiKey": "{env:BHARATCODE_API_KEY}"
      },
      "models": {
        "glm-5.3-flash": {
          "name": "BharatCode GLM-5.3 Flash",
          "limit": {
            "context": 262144,
            "output": 32000
          }
        },
        "deepseek-v4.1-flash": {
          "name": "BharatCode DeepSeek v4.1 Flash",
          "limit": {
            "context": 1000000,
            "output": 32000
          }
        }
      }
    }
  },
  "plugin": [
    "bharatcode",
    "opencode-goal-plugin",
    "@hueyexe/opencode-ensemble@0.15.1"
  ],
  "permission": {
    "external_directory": {
      "~/.local/share/opencode/worktree/**": "allow"
    }
  },
  "command": {
    "goal": {
      "description": "Set a session-scoped goal and auto-continue until complete.",
      "template": "$ARGUMENTS",
      "agent": "ultrathink"
    }
  },
  "mcp": {
    "notion": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@notionhq/notion-mcp-server"
      ],
      "enabled": true,
      "environment": {
        "NOTION_TOKEN": "{env:NOTION_TOKEN}"
      }
    }
  }
}
